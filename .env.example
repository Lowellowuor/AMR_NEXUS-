# Copy to .env and fill in real values. NEVER commit a real .env.
# -----------------------------------------------------------------

# --- Core ---
SECRET_KEY=replace-with-python-c-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
PROJECT_NAME=AMR Nexus
API_V1_STR=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite:///./amr_data.db

# --- Model artifacts ---
MODEL_DIR=./saved_models
MODEL_PATH=./saved_models/mdr_model.pkl
SHAP_BACKGROUND_PATH=./saved_models/shap_background.parquet

# --- Training data ---
TRAINING_DATA_PATH=
DATA_FILE_PATH=
ANOMALY_FILE_PATH=
ANOMALY_RATIO=0.05
TARGET_COL=mdr_flag
MDR_THRESHOLD=0.5
CSV_ENCODING=utf-8
LIMIT=
SPLIT_BY_TIME=true

# --- XGBoost ---
XGB_N_ESTIMATORS=200
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.05
XGB_TREE_METHOD=hist
XGB_RANDOM_STATE=42

# --- Alerting / analytics ---
ALERT_MDR_THRESHOLD=0.85
ALERT_ANOMALY_DAYS=30
SHAP_TOP_FEATURES=5
RISK_WEIGHTS={}
ANOMALY_CONTAMINATION=0.05
RESISTANCE_THRESHOLD=0.5
GEOGRAPHY_COLUMN=county

# --- Defaults ---
DEFAULT_SAMPLE_MONTH=1
DEFAULT_AGE_FALLBACK=-1.0
DEFAULT_STRING_FALLBACK=unknown
DEFAULT_TEST_METHOD=Disk diffusion

# --- SMS (Africa's Talking) ---
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AT_SENDER_ID=AMRNEXUS
ENABLE_SMS=false

# --- SMTP (email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@amrnexus.org

# --- External APIs ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Default admin user (first-run seed) ---
DEFAULT_USER_NAME=System Administrator
DEFAULT_USER_EMAIL=admin@amrnexus.com
DEFAULT_USER_ROLE=admin
DEFAULT_USER_COUNTY=Nairobi